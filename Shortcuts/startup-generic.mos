/*
  Script to load dependencies (Modelica libraries, eFMU SiL-stubs, source code co-simulation FMUs
  of exported eFMU production codes, etc).
  
  IMPORTANT: Environment variable EFMI_PSS_ROOT must be set by DoubleClickAndRunDymolaScript.bat.
*/

(EFMI_PSS_ROOT, EFMI_PSS_ROOT_EXISTS) := .Modelica.Utilities.System.getEnvironmentVariable(
  name = "EFMI_PSS_ROOT",
  convertToSlash = true);
if EFMI_PSS_ROOT_EXISTS and cd(EFMI_PSS_ROOT + "/Modelica/work") then
  openModel(EFMI_PSS_ROOT + "/dependencies/openipsl/OpenIPSL/package.mo");
  openModel(EFMI_PSS_ROOT + "/Modelica/OpenIPSL_CHIL/package.mo");
  .DymolaEmbedded_menu.load_all("OpenIPSL_CHIL");
else
  EFMI_PSS_ROOT_EXISTS := false;
  .Modelica.Utilities.Streams.error("ERROR: EFMI_PSS_ROOT does not exist or is not a directory.");
end if;
